# Copy this file to .env and fill in ONE provider.
# Model names change over time: use any current model from your provider's model list.

# --- Option A: OpenAI ---------------------------------------------------
#LLM_MODEL=openai:gpt-4.1-mini
#OPENAI_API_KEY=sk-...

# --- Option B: Groq (free tier) -----------------------------------------
LLM_MODEL=groq:llama-3.3-70b-versatile
GROQ_API_KEY=gsk_...

# --- Option C: Google Gemini (free tier) --------------------------------
# LLM_MODEL=google_genai:gemini-2.5-flash
# GOOGLE_API_KEY=...

# --- Option D: Ollama (runs on your machine, no key) --------------------
# LLM_MODEL=ollama:llama3.1

# --- Embeddings ----------------------------------------------------------
# Default: free local model (downloads ~90 MB the first time)
EMBEDDINGS_MODEL=huggingface:sentence-transformers/all-MiniLM-L6-v2
# EMBEDDINGS_MODEL=openai:text-embedding-3-small
# EMBEDDINGS_MODEL=google_genai:models/text-embedding-004

# Currency symbol shown in the UI
CURRENCY=$
